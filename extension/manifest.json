{
  "manifest_version": 3,
  "name": "UsageDock Connector",
  "version": "0.2.0",
  "description": "Keeps UsageDock in sync with your Claude usage page, checking it in a minimized window every 15 minutes. Local only.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "UsageDock Connector", "default_popup": "popup.html" },
  "icons": { "32": "icon32.png", "128": "icon128.png" }
}
