{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UsageDock",
  "version": "0.1.0",
  "identifier": "com.usagedock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bridge && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "AI usage monitor for Windows",
    "longDescription": "UsageDock shows your Claude, ChatGPT and Codex usage limits in the system tray and a floating desktop widget.",
    "externalBin": [
      "binaries/usagedock-bridge"
    ],
    "resources": {
      "../extension/": "extension/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "UsageDock",
    "copyright": "© 2026 UsageDock"
  }
}